{
  "name": "midcreek-cs-2",
  "private": false,
  "version": "0.1.0",
  "description": "A Three.js/WebGL concept game exploring Midcreek's Cel Shift art direction.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=22"
  }
}
